{
  "name": "@emresandikci/pocketbase-query",
  "version": "0.4.1",
  "description": "A pocketbase query builder",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --env.NODE_ENV production",
    "test": "jest",
    "typecheck": "tsc",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "validate": "prettier --check \"src/**/*.{js,ts}\" && npm run lint",
    "commit": "git-cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "npm run format",
      "npm run lint:fix",
      "npm run validate"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emresandikci/pocketbase-query.git"
  },
  "keywords": [
    "pocketbase",
    "query",
    "query",
    "builder",
    "orm"
  ],
  "author": "emresandikci",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emresandikci/pocketbase-query/issues"
  },
  "homepage": "https://github.com/emresandikci/pocketbase-query#readme",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
